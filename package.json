{
	"name": "reform-collective-library",
	"version": "1.0.0",
	"description": "collection of utilities and helpers for reform collective",
	"//": "anything that the supermodule may also install should use the ^major syntax. this is so that pnpm can combine duplicate versions to prevent inflating the bundle. this doesn't apply to dev dependencies (e.g. biome)",
	"dependencies": {
		"@macaron-css/integration": "1.5.1",
		"@mux/blurup": "1.0.2",
		"@mux/mux-video-react": "0.27.0",
		"@types/fs-extra": "11.0.4",
		"@vanilla-extract/compiler": "0.3.1",
		"ahooks": "^3",
		"browser-dtector": "4.1.0",
		"fs-extra": "11.3.2",
		"lenis": "1.3.11",
		"minisearch": "^7",
		"restyle": "3.4.2",
		"sanity-image": "1.0.0",
		"sonner": "^2",
		"stylis": "4.3.6",
		"use-deep-compare": "^1",
		"valibot": "^1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"@types/stylis": "^4.2.7",
		"@types/three": "^0.180",
		"typescript": "^5.9.2",
		"webpack": "5.102.0"
	},
	"scripts": {
		"lint": "biome lint",
		"format": "biome check --write"
	},
	"preinstall": "npx only-allow pnpm",
	"packageManager": "pnpm@10.17.1",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.8.0",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "10.17.1",
			"onFail": "download"
		}
	}
}
