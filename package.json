	"dependencies": {
		"@eslint/css-tree": "3.6.8",
		"@mux/blurup": "1.0.2",
		"@mux/mux-video-react": "^0",
		"@sanity/image-url": "2.0.2",
		"@vanilla-extract/css": "^1",
		"@vanilla-extract/next-plugin": "*",
		"@vanilla-extract/turbopack-plugin": "*",
		"ahooks": "^3",
		"browser-dtector": "4.1.1",
		"class-variance-authority": "0.7.1",
		"lenis": "1.3.16",
		"minisearch": "^7",
		"restyle": "3.4.2",
		"rxjs": "7.8.2",
		"sanity-image": "1.0.0",
		"sonner": "^2",
		"stylis": "4.3.6",
		"use-deep-compare": "^1",
		"zod": "^4.1.13"
