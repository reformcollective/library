{
	"name": "reform-collective-library",
	"version": "1.0.0",
	"description": "collection of utilities and helpers for reform collective",
	"//": "anything that the supermodule may also install should use the ^major syntax. this is so that pnpm can combine duplicate versions to prevent inflating the bundle. this doesn't apply to dev dependencies (e.g. biome)",
	"dependencies": {
		"@mux/blurup": "1.0.2",
		"@mux/mux-video-react": "0.27.0",
		"ahooks": "^3",
		"browser-dtector": "4.1.0",
		"lenis": "1.3.11",
		"minisearch": "^7",
		"restyle": "3.4.2",
		"sonner": "^2",
		"stylis": "4.3.6",
		"use-deep-compare": "^1",
		"valibot": "^1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"@types/stylis": "^4.2.7",
		"@types/three": "^0.180",
		"typescript": "^5.9.2"
	},
	"scripts": {
		"prelint": "mv biome-shared.jsonc biome.jsonc",
		"lint": "biome lint",
		"postlint": "mv biome.jsonc biome-shared.jsonc",
		"preformat": "mv biome-shared.jsonc biome.jsonc",
		"format": "biome check --write",
		"postformat": "mv biome.jsonc biome-shared.jsonc"
	},
	"preinstall": "npx only-allow pnpm",
	"packageManager": "pnpm@10.17.1",
	"engines": {
		"node": ">=22.x"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "10.17.1",
			"onFail": "download"
		}
	}
}
