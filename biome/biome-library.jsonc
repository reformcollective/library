{
	"$schema": "../node_modules/@biomejs/biome/configuration_schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"root": true,
	"plugins": ["./biome/memoization.grit", "./biome/forwardRef.grit"],
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"useSelfClosingElements": {
					"level": "info",
					"fix": "safe"
				}
			},
			"correctness": {
				"useExhaustiveDependencies": {
					"level": "error",
					"options": {
						"hooks": [
							{
								"name": "useAnimation",
								"closureIndex": 0,
								"dependenciesIndex": 1
							},
							{
								"name": "useAsyncEffect",
								"closureIndex": 0,
								"dependenciesIndex": 1
							}
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			// library can use regardless due to general lack of css
			"semicolons": "asNeeded"
		}
	},
	"files": {
		"includes": [
			"**",
			"!pnpm-lock.yaml",
			"!gsapHelpers",
			"!vanilla/turbopack-plugin.ts"
		]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	}
}
