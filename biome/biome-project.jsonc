{
	"$schema": "../../../node_modules/@biomejs/biome/configuration_schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"root": true,
	"plugins": [
		"./app/library/biome/memoization.grit",
		"./app/library/biome/forwardRef.grit"
	],
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"useSelfClosingElements": {
					"level": "info",
					"fix": "safe"
				}
			},
			"correctness": {
				"useUniqueElementIds": "off",
				"useExhaustiveDependencies": {
					"level": "error",
					"options": {
						"hooks": [
							{
								"name": "useAnimation",
								"closureIndex": 0,
								"dependenciesIndex": 1
							},
							{
								"name": "useAsyncEffect",
								"closureIndex": 0,
								"dependenciesIndex": 1
							}
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			// using prettier instead of biome's formatter until biome formats css
			"enabled": false
		}
	},
	"files": {
		"includes": ["**", "!**/pnpm-lock.yaml", "!**/app/library"]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	}
}
